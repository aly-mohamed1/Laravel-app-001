{
  "collections": [

    {
      "info": {
        "name": "Posts",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
      },
      "variable": [
        { "key": "base_posts", "value": "{{bas_url}}/posts" }
      ],
      "item": [
        {
          "name": "Get All Posts",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{API_token}}" }
            ],
            "url": "{{base_posts}}"
          }
        },
        {
          "name": "Get Post By ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{API_token}}" }
            ],
            "url": "{{base_posts}}/1"
          }
        },
        {
          "name": "Create Post",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{API_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"New Post\",\n  \"content\": \"Post content\"\n}"
            },
            "url": "{{base_posts}}"
          }
        },
        {
          "name": "Update Post",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{API_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_posts}}/1"
          }
        },
        {
          "name": "Delete Post",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{API_token}}" }
            ],
            "url": "{{base_posts}}/1"
          }
        }
      ]
    },

    {
      "info": {
        "name": "Comments",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
      },
      "variable": [
        { "key": "base_comments", "value": "{{bas_url}}/comments" }
      ],
      "item": [
        {
          "name": "Get All Comments",
          "request": {
            "method": "GET",
            "url": "{{base_comments}}"
          }
        },
        {
          "name": "Create Comment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Comment text\"\n}"
            },
            "url": "{{base_comments}}"
          }
        }
      ]
    },

    {
      "info": {
        "name": "Users",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
      },
      "variable": [
        { "key": "base_users", "value": "{{bas_url}}/users" }
      ],
      "item": [
        {
          "name": "Get Users",
          "request": {
            "method": "GET",
            "url": "{{base_users}}"
          }
        },
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John\",\n  \"email\": \"john@example.com\",\n  \"password\": \"123456\"\n}"
            },
            "url": "{{base_users}}"
          }
        }
      ]
    },

    {
      "info": {
        "name": "Reactions",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
