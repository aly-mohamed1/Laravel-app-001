      },
      "variable": [
        { "key": "base_post_statuses", "value": "{{bas_url}}/post-statuses" }
      ],
      "item": [
        {
          "name": "Get Post Statuses",
          "request": {
            "method": "GET",
            "url": "{{base_post_statuses}}"
          }
        }
      ]
    },

    {
      "info": {
        "name": "Init",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
      },
      "variable": [
        { "key": "base_init", "value": "{{bas_url}}/init" }
